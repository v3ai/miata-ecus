(symbol (lib_id "Jumper:Jumper_2_Open") (at 147.32 248.92 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid a54b56b3-ccf6-4b5b-a62c-31030116452d) (property "Reference" "JP5" (at 147.32 246.62 0) (effects (font (size 1.27 1.27)))) (property "Value" "TACH COP" (at 147.32 251.22 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Note" "Leave OPEN with the stock igniter: it drives the tachometer and sends its signal to the ECU on 2I. Fit only after a coil-on-plug conversion with the igniter removed: the ECU then drives the tachometer through 2I (R37 is its 12 V pull-up; join the two tach wires at the old igniter plug). Shunt: 2.54 mm jumper cap (LCSC C5305), fitted by hand" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid 33bfc928-6d85-485c-91ba-ef4141faacbd)) (pin "2" (uuid b2445f5b-e2ba-45bb-b974-b0901869f95f)) (instances (project "miata_mb_8995" (path "/43db9cb4-9227-4909-99ed-03cafc2267bc/026e906a-3995-4d4e-ad38-1bd191f4d5bb" (reference "JP5") (unit 1)))))
