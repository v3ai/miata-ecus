(symbol (lib_id "Jumper:Jumper_3_Open") (at 35.56 248.92 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid 4279b51e-35fb-44df-80cf-9e9659363e6b) (property "Reference" "JP1" (at 33.02 251.46 0) (effects (font (size 1.27 1.27)))) (property "Value" "INJ3" (at 35.56 246.126 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical" (at 35.56 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "" (at 35.56 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "LCSC" "C49257" (at 35.56 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Note" "Injector 3 driver. No shunt = 1989-93 stock harness: the two injector wires 2U and 2V each have one driver (INJ1, INJ2). SEQ = its own wire 2Y (1994-95, or a 1989-93 car with one wire per injector). PAIR = in parallel with INJ2 on 2V: only with a rev 0.9 daughterboard on a 1989-93 car. Shunt: 2.54 mm jumper cap (LCSC C5305), fitted by hand" (at 35.56 248.92 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid d9c93686-aa0b-40b1-ab6c-4e34c590706e)) (pin "2" (uuid e770b6a0-4ccc-41c4-affe-0a94a619505d)) (pin "3" (uuid 09cd87e6-e79e-4b64-a4ba-dfbd019759e4)) (instances (project "miata_mb_8995" (path "/b8bd24d0-5462-4e02-9419-0762fe22a019/9380fb03-52d8-4905-9ae9-716ad9086b09" (reference "JP1") (unit 1)))))
