(symbol (lib_id "Jumper:Jumper_2_Open") (at 147.32 248.92 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid 7fbd172d-355c-429a-8301-da4593bad086) (property "Reference" "JP5" (at 147.32 246.62 0) (effects (font (size 1.27 1.27)))) (property "Value" "TACH COP" (at 147.32 251.22 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Note" "Leave OPEN with the stock igniter: it drives the tachometer and sends its signal to the ECU on 2I. Fit only after a coil-on-plug conversion with the igniter removed: the ECU then drives the tachometer through 2I (R37 is its 12 V pull-up; join the two tach wires at the old igniter plug). Shunt: 2.54 mm jumper cap (LCSC C5305), fitted by hand" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid b55f729a-370a-4ce0-bd44-a69378dc60e2)) (pin "2" (uuid 7324a3ff-c824-44e7-8072-dba4ad364b67)) (instances (project "miata_mb_8995" (path "/b8bd24d0-5462-4e02-9419-0762fe22a019/9380fb03-52d8-4905-9ae9-716ad9086b09" (reference "JP5") (unit 1)))))
