(symbol (lib_id "Jumper:Jumper_2_Open") (at 35.56 248.92 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid ffb3da80-661c-4ff1-8ee1-a01a50d1e9fc) (property "Reference" "JP5" (at 35.56 246.62 0) (effects (font (size 1.27 1.27)))) (property "Value" "TACH COP" (at 35.56 251.22 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (at 35.56 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "" (at 35.56 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Note" "Leave OPEN with the stock igniter: it drives the tachometer and sends its signal to the ECU on 2I. Fit only after a coil-on-plug conversion with the igniter removed: the ECU then drives the tachometer through 2I (R37 is its 12 V pull-up; join the two tach wires at the old igniter plug). Shunt: 2.54 mm jumper cap (LCSC C5305), fitted by hand" (at 35.56 248.92 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid f5d57248-8597-4efd-b266-4835d577c780)) (pin "2" (uuid 459269ad-0ac7-43ce-bedc-918bafd1cd57)) (instances (project "miata_mb_8995" (path "/11c53c7e-fcf0-44f1-9dd4-af573f502b26/f6158078-af1b-4a5e-a4dd-eaa5d8d77ad8" (reference "JP5") (unit 1)))))
(symbol (lib_id "Jumper:Jumper_3_Open") (at 63.5 248.92 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid 0513c1bb-5105-475d-b51c-10ef8fe4e4bd) (property "Reference" "JP6" (at 60.96 251.46 0) (effects (font (size 1.27 1.27)))) (property "Value" "2O" (at 63.5 246.126 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical" (at 63.5 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "" (at 63.5 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "LCSC" "C49257" (at 63.5 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Note" "Airflow meter signal wire 2O: AFM = to the spare analog input (every year: the meter stays plugged in for its air-temperature sensor, and on 1989-93 its pump contact runs the fuel pump as stock). BOOST = the boost driver on that wire, only on a 1989-93 car whose airflow meter comes out: it then runs the fuel pump relay (link the meter plug's pump-contact cavity to its signal cavity, set the Fuel pump pin to the boost output). Shunt: 2.54 mm jumper cap (LCSC C5305), fitted by hand" (at 63.5 248.92 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid cc80ed64-c143-454e-a6ae-be920b4109d7)) (pin "2" (uuid 036feebb-d6a9-4cdc-8cbd-9e4ea3b9c5d9)) (pin "3" (uuid 7f153e18-6836-4b29-a676-1160bbe60767)) (instances (project "miata_mb_8995" (path "/11c53c7e-fcf0-44f1-9dd4-af573f502b26/f6158078-af1b-4a5e-a4dd-eaa5d8d77ad8" (reference "JP6") (unit 1)))))
