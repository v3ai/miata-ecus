(symbol (lib_id "Jumper:Jumper_2_Open") (at 147.32 248.92 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid 9cd23d4d-92be-48f6-9c98-1b54be3a4803) (property "Reference" "JP5" (at 147.32 246.62 0) (effects (font (size 1.27 1.27)))) (property "Value" "TACH COP" (at 147.32 251.22 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Note" "Leave OPEN with the stock igniter: it drives the tachometer and sends its signal to the ECU on 2I. Fit only after a coil-on-plug conversion with the igniter removed: the ECU then drives the tachometer through 2I (R37 is its 12 V pull-up; join the two tach wires at the old igniter plug). Shunt: 2.54 mm jumper cap (LCSC C5305), fitted by hand" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid b7a5c57d-eb6f-4be4-af2d-9c27c2d38d52)) (pin "2" (uuid c3c27b06-7a39-41c4-bcc7-dc67073001f2)) (instances (project "miata_mb_8995" (path "/4c4e3275-e90e-447f-ad10-5c30d0ebfde3/4cf9e64a-67ce-43a7-9cc1-b278bbadf2fe" (reference "JP5") (unit 1)))))
