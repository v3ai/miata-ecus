(symbol (lib_id "Jumper:Jumper_2_Open") (at 147.32 248.92 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid ef1739e7-d906-4213-8e07-bd0e8c161d15) (property "Reference" "JP5" (at 147.32 246.62 0) (effects (font (size 1.27 1.27)))) (property "Value" "TACH COP" (at 147.32 251.22 0) (effects (font (size 1.27 1.27)))) (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (property "Note" "Leave OPEN with the stock igniter: it drives the tachometer and sends its signal to the ECU on 2I. Fit only after a coil-on-plug conversion with the igniter removed: the ECU then drives the tachometer through 2I (R37 is its 12 V pull-up; join the two tach wires at the old igniter plug). Shunt: 2.54 mm jumper cap (LCSC C5305), fitted by hand" (at 147.32 248.92 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid 75cdeaa2-075e-476a-a8a0-659ac6d755f5)) (pin "2" (uuid 95f20442-ff85-4beb-b119-1df3d0d429b9)) (instances (project "miata_mb_8995" (path "/461210ed-34ee-4036-a063-02b53d3e35b3/902ae77e-2a83-445c-8404-f275110d3b2f" (reference "JP5") (unit 1)))))
