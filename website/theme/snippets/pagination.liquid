{%- doc -%}
  Page links for a paginated list.
  @param {object} paginate - the paginate object
{%- enddoc -%}
<nav aria-label="{{ 'general.pagination' | t }}">
  <ul class="pagination" role="list">
    {%- if paginate.previous -%}
      <li><a href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}">&larr;</a></li>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      <li>
        {%- if part.is_link -%}
          <a href="{{ part.url }}">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span class="is-current" aria-current="page">{{ part.title }}</span>
        {%- else -%}
          <span>{{ part.title }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- if paginate.next -%}
      <li><a href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}">&rarr;</a></li>
    {%- endif -%}
  </ul>
</nav>
