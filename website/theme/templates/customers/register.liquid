<div class="page-width main-page" style="max-width:720px">
  <h1 class="h1">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer', class: 'stack', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<div class="form-message" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="reg-first">{{ 'customer.first_name' | t }}</label><input id="reg-first" type="text" name="customer[first_name]" autocomplete="given-name"></div>
    <div class="field"><label for="reg-last">{{ 'customer.last_name' | t }}</label><input id="reg-last" type="text" name="customer[last_name]" autocomplete="family-name"></div>
    <div class="field"><label for="reg-email">{{ 'customer.email' | t }}</label><input id="reg-email" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="field"><label for="reg-password">{{ 'customer.password' | t }}</label><input id="reg-password" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div><button class="btn" type="submit">{{ 'customer.register.submit' | t }}</button></div>
  {%- endform -%}
</div>
