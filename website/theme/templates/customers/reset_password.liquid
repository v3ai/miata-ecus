<div class="page-width main-page" style="max-width:720px">
  <h1 class="h1">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'stack' -%}
    {%- if form.errors -%}<div class="form-message" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="rs-pass">{{ 'customer.password' | t }}</label><input id="rs-pass" type="password" name="customer[password]" autocomplete="new-password"></div>
    <div class="field"><label for="rs-pass2">{{ 'customer.password_confirm' | t }}</label><input id="rs-pass2" type="password" name="customer[password_confirmation]" autocomplete="new-password"></div>
    <div><button class="btn" type="submit">{{ 'customer.reset.submit' | t }}</button></div>
  {%- endform -%}
</div>
