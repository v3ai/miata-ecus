<div class="page-width">
  <header class="collection-head">
    <h1 class="h1">{{ section.settings.heading | escape }}</h1>
  </header>
  <ul class="product-grid product-grid--3" role="list">
    {%- for collection in collections -%}
      <li>
        <article class="card">
          <div class="card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 50vw' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="card__body">
            <h2 class="card__title h4"><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2>
            <span class="eyebrow">{{ 'collections.count' | t: count: collection.products_count }}</span>
          </div>
        </article>
      </li>
    {%- endfor -%}
  </ul>
</div>
<div class="section--tight"></div>

{% schema %}
{
  "name": "Collections list",
  "class": "section-main-list-collections",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" } ]
}
{% endschema %}
