<div class="password-page">
  <div class="stack">
    <p class="display">{{ shop.name | escape }}</p>
    {%- if shop.password_message != blank -%}<p class="lede">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter', style: 'margin-inline:auto' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      <label class="visually-hidden" for="pw-email">{{ 'newsletter.label' | t }}</label>
      <input class="input" style="border-color:var(--black)" id="pw-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" required>
      <button class="btn" type="submit">{{ 'newsletter.submit' | t }}</button>
      {%- if form.posted_successfully? -%}<p role="status" style="flex-basis:100%;margin:12px 0 0">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}
    <details>
      <summary class="label" style="cursor:pointer">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter', style: 'margin-top:16px' -%}
        {%- if form.errors -%}<p role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="visually-hidden" for="pw-pass">{{ 'password.label' | t }}</label>
        <input class="input" style="border-color:var(--black)" id="pw-pass" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
        <button class="btn" type="submit">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{ "name": "Password", "class": "section-password", "settings": [] }
{% endschema %}
