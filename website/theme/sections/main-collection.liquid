<div class="page-width">
  <header class="collection-head">
    <p class="eyebrow">{{ 'collections.label' | t }}</p>
    <h1 class="h1">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}<div class="rte lede">{{ collection.description }}</div>{%- endif -%}
  </header>
  {%- paginate collection.products by section.settings.per_page -%}
    {%- if collection.products.size > 0 -%}
      <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="lede">{{ 'collections.empty' | t }}</p>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  {%- endpaginate -%}
</div>
<div class="section--tight"></div>

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 48, "step": 3, "default": 24 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "3", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] }
  ]
}
{% endschema %}
